<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.ai.mapper.BizApprovalMapper">

    <select id="selectByApplicant" resultType="com.ruoyi.ai.entity.BizApproval">
        SELECT * FROM biz_approval WHERE applicant = #{applicant} ORDER BY create_time DESC
    </select>

    <select id="selectAll" resultType="com.ruoyi.ai.entity.BizApproval">
        SELECT * FROM biz_approval ORDER BY create_time DESC
    </select>

</mapper>
